[sub_resource type="Shader" id="Shader_m3wxv"]
code = "shader_type canvas_item;
render_mode blend_add;
void fragment() {
	// the tile slides down the stream, a little faster in the middle
	float edge = 1.0 - abs(UV.x - 0.5) * 2.0;
	COLOR = texture(TEXTURE, vec2(UV.x, UV.y - TIME * (5.0 + edge))) * COLOR;
	COLOR.a *= 0.55 + 0.45 * edge;
}
"

