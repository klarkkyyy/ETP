[sub_resource type="Shader" id="Shader_sa154"]
code = "shader_type canvas_item;
render_mode blend_add;
uniform float seed = 0.0;
uniform float period = 9.0;
void fragment() {
	// open most of the time; a quick blink once a period, at its own moment
	float t = fract(TIME / period + seed);
	float open = smoothstep(0.0, 0.03, abs(t - 0.5));
	float slow = 0.75 + 0.25 * sin(TIME * 0.7 + seed * 6.28);
	COLOR = texture(TEXTURE, UV) * COLOR;
	COLOR.a *= step(abs(UV.y - 0.5) * 2.0, open) * slow;
}
"

