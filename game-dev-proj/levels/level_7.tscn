[sub_resource type="CanvasItemMaterial" id="CanvasItemMaterial_77myf"]
blend_mode = 1

[sub_resource type="Shader" id="Shader_knwsw"]
code = "shader_type canvas_item;
render_mode blend_add;
void fragment() {
	// bands of brighter and duller metal sliding down the stream
	float flow = 0.75 + 0.25 * sin(UV.y * 90.0 - TIME * 9.0) * sin(UV.y * 23.0 - TIME * 4.0);
	float edge = 1.0 - abs(UV.x - 0.5) * 2.0;
	COLOR = vec4(COLOR.rgb * flow, COLOR.a * (0.35 + 0.65 * edge));
}
"

